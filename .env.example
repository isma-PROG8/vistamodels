# Ruta a la base de datos PostgreSQL (relativa a la raíz del proyecto)
DATABASE_URL="jujuxD"

# NOTA: La API key de Z.ai NO se lee desde variable de entorno.
# Debes crear un archivo .z-ai-config en la raíz del proyecto (o en tu home)
# con el siguiente contenido JSON:
#
# {
#   "baseUrl": "https://api.z.ai/api/paas/v4",
#   "apiKey": "TU_API_KEY_AQUI"
# }
#
# Consigue tu API key en https://chat.z.ai
# El archivo .z-ai-config ya está incluido en este ZIP con la clave
# que funcionaba en el entorno sandbox. Cámbiala por la tuya propia
# cuando la subas a producción.
